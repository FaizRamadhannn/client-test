---
import type { Business } from "../../data/business";
import Button from "../ui/Button.astro";
import { createWhatsAppUrl } from "../../utils/whatsapp";

interface Props {
  business: Business;
  lang?: "id" | "en";
}

const {
  business,
  lang = "id",
} = Astro.props;

const content = business.content[lang];

const whatsappMessage =
  content.cta.whatsappMessage ||
  `Halo, saya ingin mendapatkan informasi mengenai ${business.identity.name}.`;

const whatsappUrl = createWhatsAppUrl(
  business.contact.whatsapp,
  whatsappMessage,
  "#contact",
);

const navItems =
  lang === "id"
    ? [
        { label: "Tentang", href: "#about" },
        { label: "Layanan", href: "#services" },
        { label: "Menu", href: "#menu" },
        { label: "Keunggulan", href: "#why-choose-us" },
        { label: "Proses", href: "#process" },
        { label: "Galeri", href: "#gallery" },
        { label: "Testimoni", href: "#testimonials" },
        { label: "FAQ", href: "#faq" },
        { label: "Kontak", href: "#contact" },
      ]
    : [
        { label: "About", href: "#about" },
        { label: "Services", href: "#services" },
        { label: "Menu", href: "#menu" },
        { label: "Why Us", href: "#why-choose-us" },
        { label: "Process", href: "#process" },
        { label: "Gallery", href: "#gallery" },
        { label: "Testimonials", href: "#testimonials" },
        { label: "FAQ", href: "#faq" },
        { label: "Contact", href: "#contact" },
      ];

const languageUrl = lang === "id" ? "/en/" : "/";
const languageLabel = lang === "id" ? "EN" : "ID";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#2b0b14] text-white shadow-lg shadow-[#2b0b14]/10">
  <div class="hidden border-b border-white/10 bg-[#6b1d2f] md:block">
    <div class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-2 text-[0.68rem] tracking-[0.04em] text-white/80 sm:px-6 lg:px-8">
      <span>{business.location.address}, {business.location.city}</span>
      <span>{business.hours.monday} · <a href={`tel:${business.contact.phone}`} class="hover:text-[#e8a87c]">{business.contact.phone}</a></span>
    </div>
  </div>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-5 sm:px-6 lg:px-8">

    <!-- Brand -->
    <a
      href={lang === "id" ? "/" : "/en/"}
      class="max-w-[220px] truncate font-serif text-xl font-bold tracking-[0.08em] text-white"
      aria-label={business.identity.name}
    >
      {business.identity.name}
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden items-center gap-5 lg:flex"
      aria-label={lang === "id" ? "Navigasi utama" : "Main navigation"}
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-xs font-semibold uppercase tracking-[0.08em] text-white/70 transition-colors hover:text-[#e8a87c]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden items-center gap-3 lg:flex">

      <a
        href={languageUrl}
        class="rounded px-3 py-2 text-xs font-semibold text-white/75 hover:bg-white/10"
        aria-label={
          lang === "id"
            ? "Switch to English"
            : "Ganti ke Bahasa Indonesia"
        }
      >
        {languageLabel}
      </a>

      <Button href={whatsappUrl} class="rounded-full bg-[#e8a87c] px-5 py-2 text-xs uppercase tracking-[0.1em] text-[#2b0b14] hover:bg-white">
        {content.cta.buttonText}
      </Button>

    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="inline-flex items-center justify-center rounded p-2 text-white hover:bg-white/10 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={lang === "id" ? "Buka menu" : "Open menu"}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>

  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-[#2b0b14] lg:hidden"
  >
    <nav
      class="mx-auto flex max-w-[1200px] flex-col px-5 py-4 sm:px-6"
      aria-label={lang === "id" ? "Navigasi mobile" : "Mobile navigation"}
    >

      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="border-b border-white/10 py-3 text-sm font-medium text-white/80"
          >
            {item.label}
          </a>
        ))
      }

      <div class="flex items-center gap-3 pt-4">

        <a
          href={languageUrl}
          class="flex-1 rounded border border-white/20 px-4 py-3 text-center text-sm font-semibold"
        >
          {languageLabel}
        </a>

        <a
          href={whatsappUrl}
          class="flex-1 rounded bg-[#e8a87c] px-4 py-3 text-center text-sm font-semibold text-[#2b0b14]"
        >
          {content.cta.buttonText}
        </a>

      </div>

    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-button",
  );

  const menu = document.querySelector<HTMLElement>(
    "#mobile-menu",
  );

  if (button && menu) {
    button.addEventListener("click", () => {
      const isOpen =
        button.getAttribute("aria-expanded") === "true";

      button.setAttribute(
        "aria-expanded",
        String(!isOpen),
      );

      menu.classList.toggle("hidden", isOpen);
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        button.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
      });
    });
  }

  document.querySelectorAll<HTMLImageElement>("img[data-fallback-src]").forEach(
    (image) => {
      image.addEventListener("error", () => {
        const fallback = image.dataset.fallbackSrc;

        if (fallback && image.src !== new URL(fallback, document.baseURI).href) {
          image.src = fallback;
        }
      });
    },
  );
</script>