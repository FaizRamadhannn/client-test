---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const {
  eyebrow,
  title,
  description,
  align = "left",
} = Astro.props;
---

<div
  class:list={[
    "mb-10 max-w-2xl",
    align === "center" && "mx-auto text-center",
  ]}
>
  {eyebrow && (
    <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">
      {eyebrow}
    </p>
  )}

  <h2 class="text-3xl leading-tight sm:text-4xl">
    {title}
  </h2>

  {description && (
    <p class="mt-4 max-w-xl text-base leading-7 text-[var(--color-muted-foreground)] sm:text-lg">
      {description}
    </p>
  )}
</div>